{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CryptoIntelligenceSystem/infrastructure/contracts/v1/news_article.schema.json",
  "title": "news_article v1",
  "description": "Value of a Kafka message on topic news_data: one news article. Message key = article_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "data_type", "source", "article_id", "title", "summary",
    "url", "published_at", "collected_at", "symbols", "sentiment"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "data_type": { "const": "news" },
    "source": {
      "description": "News source identifier, lowercase snake_case (e.g. coindesk).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,49}$"
    },
    "article_id": {
      "description": "First 24 hex chars of sha256(url).",
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "description": "Plain text, HTML removed; may be empty." },
    "url": { "type": "string", "pattern": "^https?://" },
    "published_at": { "$ref": "#/$defs/utc_ms" },
    "collected_at": { "$ref": "#/$defs/utc_ms" },
    "symbols": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z0-9]{5,20}$" },
      "uniqueItems": true
    },
    "sentiment": { "type": ["string", "null"], "description": "Always null in v1." }
  },
  "$defs": {
    "utc_ms": {
      "description": "ISO-8601 UTC with exactly millisecond precision and Z suffix. Spark format: yyyy-MM-dd'T'HH:mm:ss.SSSX",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
