{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CryptoIntelligenceSystem/infrastructure/contracts/v1/market_kline.schema.json",
  "title": "market_kline v1",
  "description": "Value of a Kafka message on topic market_data: one closed OHLCV candle. Message key = symbol. Business rules not expressible here (consumers must also check): low <= open <= high, low <= close <= high, close_time > open_time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "data_type", "source", "symbol", "interval",
    "open_time", "close_time", "open", "high", "low", "close",
    "volume", "quote_volume", "trade_count", "collected_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "data_type": { "const": "market" },
    "source": {
      "description": "Binance market the candle comes from.",
      "enum": ["binance_spot", "binance_futures"]
    },
    "symbol": { "type": "string", "pattern": "^[A-Z0-9]{5,20}$" },
    "interval": { "enum": ["1m"] },
    "open_time": { "$ref": "#/$defs/utc_ms" },
    "close_time": { "$ref": "#/$defs/utc_ms" },
    "open": { "$ref": "#/$defs/price" },
    "high": { "$ref": "#/$defs/price" },
    "low": { "$ref": "#/$defs/price" },
    "close": { "$ref": "#/$defs/price" },
    "volume": { "type": "number", "minimum": 0 },
    "quote_volume": { "type": "number", "minimum": 0 },
    "trade_count": { "type": "integer", "minimum": 0 },
    "collected_at": { "$ref": "#/$defs/utc_ms" }
  },
  "$defs": {
    "utc_ms": {
      "description": "ISO-8601 UTC with exactly millisecond precision and Z suffix. Spark format: yyyy-MM-dd'T'HH:mm:ss.SSSX",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "price": { "type": "number", "exclusiveMinimum": 0 }
  }
}
