KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# MINIO_ROOT_PASSWORD is embedded in a URL by mc-init: avoid @ : / characters.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_RAW_BUCKET=raw-data
MINIO_CHECKPOINT_BUCKET=checkpoints
CLICKHOUSE_DB=pipeline
CLICKHOUSE_USER=pipeline_user
CLICKHOUSE_PASSWORD=change-this-clickhouse-password
CLICKHOUSE_JDBC_DRIVER=com.clickhouse.jdbc.ClickHouseDriver

# Path to the data-pipeline repo (Spark job code), relative to this directory.
PIPELINE_REPO_DIR=../data-pipeline

# Spark worker resources offered to jobs, and container limits (master hosts the job drivers).
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=3g
SPARK_WORKER_MEM_LIMIT=4g
SPARK_WORKER_CPUS=4
SPARK_MASTER_MEM_LIMIT=3g
SPARK_MASTER_CPUS=2
